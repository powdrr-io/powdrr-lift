{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powdrr.io/schemas/local-validation-predicate-v1.json",
  "title": "Powdrr local validation in-toto statement v1",
  "type": "object", "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string", "minLength": 1}, "digest": {"type": "object", "additionalProperties": false, "required": ["sha1"], "properties": {"sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}}},
    "predicateType": {"const": "https://powdrr.io/attestation/local-validation/v1"},
    "predicate": {"$ref": "#/$defs/predicate"}
  },
  "$defs": {
    "hex256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predicate": {"type": "object", "additionalProperties": false, "required": ["repository", "principal", "provider", "source", "policy", "environment", "run", "steps"], "properties": {
      "repository": {"type": "object", "additionalProperties": false, "required": ["id", "full_name"], "properties": {"id": {"type": "integer", "minimum": 1}, "full_name": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}}},
      "principal": {"type": "object", "additionalProperties": false, "required": ["github_user_id"], "properties": {"github_user_id": {"type": "integer", "minimum": 1}}},
      "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version", "key_id", "security_profile"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "security_profile": {"type": "string", "minLength": 1}}},
      "source": {"type": "object", "additionalProperties": false, "required": ["object_format", "commit", "tree", "snapshot_sha256"], "properties": {"object_format": {"const": "sha1"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "snapshot_sha256": {"$ref": "#/$defs/hex256"}}},
      "policy": {"type": "object", "additionalProperties": false, "required": ["path", "trusted_ref", "resolved_commit", "sha256", "candidate_sha256"], "properties": {"path": {"const": ".github/local-validation.yaml"}, "trusted_ref": {"type": "string", "pattern": "^refs/heads/.+$"}, "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"$ref": "#/$defs/hex256"}, "candidate_sha256": {"oneOf": [{"$ref": "#/$defs/hex256"}, {"type": "null"}]}}},
      "environment": {"type": "object", "additionalProperties": false, "required": ["os", "os_version", "architecture", "toolchain_id", "toolchain_sha256", "network", "execution_identity"], "properties": {"os": {"const": "macos"}, "os_version": {"type": "string", "minLength": 1}, "architecture": {"enum": ["arm64", "x86_64"]}, "toolchain_id": {"type": "string", "minLength": 1}, "toolchain_sha256": {"$ref": "#/$defs/hex256"}, "network": {"const": "allowed"}, "execution_identity": {"const": "dedicated-worker"}}},
      "run": {"type": "object", "additionalProperties": false, "required": ["id", "started_at", "finished_at", "duration_ms", "result", "cleanup"], "properties": {"id": {"type": "string", "format": "uuid"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "duration_ms": {"type": "integer", "minimum": 0}, "result": {"enum": ["passed", "failed", "timed_out", "cancelled", "blocked"]}, "cleanup": {"enum": ["complete", "incomplete"]}}},
      "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "definition_sha256", "status", "exit_code", "signal", "duration_ms", "stdout_sha256", "stderr_sha256"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "definition_sha256": {"$ref": "#/$defs/hex256"}, "status": {"enum": ["passed", "failed", "timed_out", "cancelled", "not_run"]}, "exit_code": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]}, "signal": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 255}, {"type": "null"}]}, "duration_ms": {"type": "integer", "minimum": 0}, "stdout_sha256": {"$ref": "#/$defs/hex256"}, "stderr_sha256": {"$ref": "#/$defs/hex256"}}}}
    }}
  }
}
