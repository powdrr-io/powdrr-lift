schema: https://powdrr.io/schemas/specification-v1
title: Interaction File Log Implementation
architecture_id: '2026-08-22'
entities:
- id: interaction-log
  action: added
  rationale: Stores all human and LLM interaction inputs and outputs as required by
    req-1.
- id: interaction-entry
  action: added
  rationale: Represents a single interaction record with input and output as required
    by req-1.
- id: log-writer
  action: added
  rationale: Appends interaction entries to the log file as required by req-1.
- id: interaction-source
  action: added
  rationale: Provides interaction inputs and outputs from human or LLM as required
    by req-1.
modules:
- id: mod-log-writer
  action: added
  relative_location: src/log_writer/
  purpose: Writes interaction entries to the JSON log file in the hidden .powdrr directory.
tools:
- id: tool-log-writer
  action: added
  when_to_use: Whenever an interaction with a human or LLM occurs and needs to be
    logged.
  template: interaction-log-writer
  how_to_use: Invoke the log writer to append the interaction input and output to
    the log file.
entity_relationships:
- id: rel-writer-appends
  action: added
  rationale: The log writer appends interaction entries to the log as required by
    req-1.
- id: rel-log-contains
  action: added
  rationale: The log contains interaction entries as required by req-1.
- id: rel-source-feeds
  action: added
  rationale: Interaction sources feed inputs and outputs to the log writer as required
    by req-1.
features:
- id: feat-interaction-log
  action: added
  description: Capture all human and LLM interaction inputs and outputs in a JSON
    file log.
  functional_requirements:
  - Write interaction inputs and outputs to .powdrr/interaction-log.json in JSON format.
decisions:
- id: dec-json-format
  action: added
  description: Use JSON format for the interaction log file.
