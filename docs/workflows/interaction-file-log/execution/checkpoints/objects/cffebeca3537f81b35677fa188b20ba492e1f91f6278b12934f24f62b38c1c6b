workflow:
  name: start-implementing-feature
  path: /Users/gregory/code/powdrr-lift/skill-definitions/start-implementing-feature.yaml
  skills:
  - start-implementing-feature
  - bootstrap-code-structure
  - finish-pr-prep
  - create-pull-request
  steps:
  - description: Discover proposed feature specification candidates.
    step_type: freeform
    id: discover-proposed-feature
    details: Invoke only the declared fuzzy-match command once for docs/proposals
      using the feature name from the user's request. Do not invoke internal, shell,
      or any other tool in this step. Treat a missing root or empty result as no matches;
      do not select the feature yet.
    llm_type: standard_reasoning
    tool_invocations:
    - tool: fuzzy-match
      command:
      - fuzzy-match
      - docs/proposals
      - -name
      - <feature-name>
      - -type
      - d
      - -maxdepth
      - '2'
      - -print
  - description: Discover current feature specification candidates.
    step_type: freeform
    id: discover-current-feature
    details: Invoke only the declared fuzzy-match command once for docs/current using
      the feature name from the user's request. Do not invoke internal, shell, or
      any other tool in this step. Treat a missing root or empty result as no matches;
      do not select the feature yet.
    llm_type: standard_reasoning
    tool_invocations:
    - tool: fuzzy-match
      command:
      - fuzzy-match
      - docs/current
      - -name
      - <feature-name>
      - -type
      - d
      - -maxdepth
      - '2'
      - -print
  - description: Discover execution workflow candidates.
    step_type: freeform
    id: discover-feature-workflows
    details: Invoke only the declared fuzzy-match command once for docs/workflows
      using the feature name from the user's request. Do not invoke internal, shell,
      or any other tool in this step. Treat a missing root or empty result as no matches;
      do not select the workflow yet.
    llm_type: standard_reasoning
    tool_invocations:
    - tool: fuzzy-match
      command:
      - fuzzy-match
      - docs/workflows
      - -name
      - <feature-name>
      - -type
      - d
      - -maxdepth
      - '3'
      - -print
  - description: Select the canonical feature and workflow context.
    step_type: freeform
    id: select-feature-context
    details: 'Review all three deterministic search results. Filter them to the best
      matching feature directory and workflow directories. If exactly one feature
      specification and workflow set are the best matches, select them without asking.
      If no candidates are found, do not claim that a canonical feature was selected
      and do not use next_step or complete: ask one specific question identifying
      the missing feature or workflow path. If the user supplies an identifier or
      path, use goto_step to rerun the relevant deterministic discovery step(s), then
      select from those results. If a match is uncertain, ask one specific question
      that identifies the correct feature or workflow, for example: {"action":"prompt_user","text":"Which
      feature or workflow should I use from these candidates: <candidate-names>?"}
      Do not ask whether documents exist before searching. The feature_name output
      is required for this step; emit it only when this step has actually selected
      a canonical feature. Pass the selected specification documents, workflow documents,
      canonical feature name, and missing-document findings to the next step.'
    llm_type: standard_reasoning
    outputs:
    - name: feature_name
      type: string
      required_for_next_step: true
      scope: skill
  - description: Bootstrap the project-wide module and tool structure.
    step_type: freeform
    id: bootstrap-project-structure
    details: Invoke bootstrap-code-structure with the selected feature context. The
      nested skill is project-wide and must not ask for a feature or target module.
    llm_type: standard_reasoning
    uses_skills:
    - bootstrap-code-structure
  - description: Confirm the project-structure artifact is available.
    step_type: gate
    id: confirm-project-structure
    details: The gate passes only when the project-structure artifact exists in the
      active worktree.
    llm_type: simple_task
    pre_step:
      action: invoke_tool
      template:
        tool: shell
        command:
        - test
        - -f
        - docs/project_structure/project-structure.yaml
    gate:
      outcome:
        path: returncode
        equals: 0
      goto_step: bootstrap-project-structure
      retry_context: The project-structure artifact is not available in the active
        worktree. Rerun bootstrap-code-structure, then retry this gate.
  - description: Plan the proposed PR implementation sequence.
    step_type: freeform
    id: plan-proposed-prs
    details: If proposed PR specifications or implementation specifications already
      exist in the selected feature context, inspect them, reuse them, and pass their
      stable names and paths onward. Otherwise analyze the feature specification and
      the project structure to define ordered proposed PRs with incremental validation,
      clear boundaries, low risk, dependencies, and stable names. For each proposed
      PR, record its goal, scope, files, tests, acceptance criteria, validation commands,
      dependencies, and risks. Use the read_document action to inspect templates/execute-proposed-pr.yaml;
      do not use shell commands to read the template. Do not generate or edit implementation-specification
      files in this step. Before next_step, return exactly one output named proposed_pr_names
      containing every stable proposed PR name. Do not rely on decisions_and_context
      for this handoff.
    llm_type: high_reasoning
    outputs:
    - name: proposed_pr_names
      type: any
      required_for_next_step: true
      scope: skill
  - description: Generate one implementation specification per proposed PR.
    step_type: freeform
    id: generate-implementation-specifications
    details: For each name in proposed_pr_names that lacks an implementation specification,
      invoke the declared implementation-specification command exactly once with its
      stable proposed-PR name and output path. Reuse existing files. Generate only
      the templates; do not fill, validate, instantiate, stage, or commit them. Pass
      every generated path and proposed-PR relationship onward. Before next_step,
      return exactly one output named implementation_specification_paths containing
      every generated or reused path; do not repeat proposed_pr_names from the previous
      step and do not include any other output name.
    llm_type: high_reasoning
    tool_invocations:
    - tool: internal
      command:
      - powdrr-lift
      - implementation-specification
      - --work-item-name
      - <feature-name>
      - --output
      - docs/proposals/<feature-name>/<proposed-pr-name>-implementation-specification.yaml
    inputs:
    - name: proposed_pr_names
      type: any
      required: true
      source: previous_step
    outputs:
    - name: implementation_specification_paths
      type: any
      required_for_next_step: true
      scope: skill
  - description: Fill every implementation specification.
    step_type: freeform
    id: fill-implementation-specifications
    details: For each path in implementation_specification_paths, replace every placeholder
      and fill every required field using the selected feature, project-structure,
      and proposed-PR context. Remove generator instructions and instructional comments.
      Do not leave null, empty, example, or TODO values in required fields. Keep each
      proposed PR in its own file and preserve its stable proposed-PR id. Use yaml_edit
      for all YAML changes in this active worktree. Do not validate or instantiate
      workflows until every file is populated. Pass the exact filled paths and proposed-PR
      mapping onward.
    llm_type: high_reasoning
    inputs:
    - name: implementation_specification_paths
      type: any
      required: true
      source: previous_step
  - description: Evaluate all implementation specifications deterministically.
    step_type: invoke_tool
    id: evaluate-implementation-specifications
    details: Invoke the evaluator exactly once for the selected feature directory;
      do not edit files in this step.
    llm_type: simple_task
    pre_step:
      action: invoke_tool
      template:
        tool: internal
        command:
        - powdrr-lift
        - evaluate
        - docs/proposals/<feature-name>
  - description: Repair every reported implementation specification issue.
    step_type: freeform
    id: repair-implementation-specifications
    details: Review the deterministic evaluator result and repair every reported issue
      with yaml_edit. Use the evaluator's corrective guidance and exact file paths.
      Do not instantiate workflows, stage artifacts, request approval, or create a
      pull request while any specification is invalid. After changing the affected
      YAML, choose next_step so the deterministic evaluation step runs again; if no
      repair is needed, proceed to the validation gate.
    llm_type: fast_iteration
  - description: Confirm all implementation specifications are valid.
    step_type: gate
    id: gate-implementation-specifications
    details: The gate passes only when the directory evaluator exits successfully
      with zero issues.
    llm_type: simple_task
    pre_step:
      action: invoke_tool
      template:
        tool: internal
        command:
        - powdrr-lift
        - evaluate
        - docs/proposals/<feature-name>
    gate:
      outcome:
        path: returncode
        equals: 0
      goto_step: repair-implementation-specifications
      retry_context: The implementation-specification gate failed. Inspect the latest
        evaluator result, repair every affected YAML with yaml_edit, and rerun deterministic
        evaluation before continuing.
  - description: Plan execution workflow instantiation.
    step_type: freeform
    id: plan-workflow-instantiation
    details: For each validated proposed PR, inspect whether its matching workflow
      already exists and reuse it when present. For each missing workflow, inspect
      templates/execute-proposed-pr.yaml with read_document, resolve every task input_state
      placeholder from the matching validated implementation specification, and prepare
      the complete instantiation values. Use the fixed template, canonical feature
      name, distinct workflow instance names, proposed-PR order, and dependency relationships.
      Never ask the user for a template path, leave a required placeholder empty,
      or overwrite an existing workflow without approval. Pass an invocation plan
      containing every created or reused workflow and its proposed-PR relationship
      onward.
    llm_type: simple_task
  - description: Instantiate each missing execution workflow.
    step_type: freeform
    id: instantiate-execution-workflows
    details: Invoke instantiate-workflow once for each missing workflow using the
      invocation plan. Use templates/execute-proposed-pr.yaml, pass every template-specific
      value with repeated --template-value NAME=VALUE options, and use the canonical
      feature name as the shared work-item name. The command must create the powdrr/<proposed-pr-id>
      integration branch while writing workflow files into this active worktree. Stop
      if a returned workflow directory is outside the active worktree. Pass every
      created or reused workflow path onward.
    llm_type: simple_task
    tool_invocations:
    - tool: internal
      command:
      - powdrr-lift
      - instantiate-workflow
      - --work-item-name
      - <feature-name>
      - --workflow-instance-name
      - <proposed-pr-name>
      - --template-value
      - proposed-pr-id=<proposed-pr-name>
      - --template
      - templates/execute-proposed-pr.yaml
  - description: Inspect generated workflow repository state.
    step_type: invoke_tool
    id: inspect-workflow-repository-state
    details: Inspect the active repository state after workflow instantiation.
    llm_type: simple_task
    pre_step:
      action: invoke_tool
      template:
        tool: internal
        command:
        - powdrr-lift
        - repository-state
  - description: Verify workflow artifacts are in the active worktree.
    step_type: freeform
    id: verify-workflow-artifacts
    details: Confirm from the repository-state result that every generated workflow
      YAML metadata file and workflow task files are under docs/workflows/ in this active worktree,
      that each integration branch is powdrr/<proposed-pr-id>, and that no required
      artifact exists only below .worktrees/. If any file is missing or outside the
      active worktree, stop and report the inconsistency; do not stage or create a
      pull request.
    llm_type: fast_iteration
  - description: Stage the validated implementation and workflow artifacts.
    step_type: freeform
    id: stage-validated-artifacts
    details: Stage only docs/proposals/<feature-name>/ and docs/workflows/ with the
      shell tool, review the staged paths, and do not commit or create a pull request
      yet.
    llm_type: simple_task
    tool_invocations:
    - tool: shell
      command:
      - git
      - add
      - docs/proposals/<feature-name>
      - docs/workflows
  - description: Verify the staged artifact set.
    step_type: invoke_tool
    id: verify-staged-artifacts
    details: Confirm that only the validated planning artifacts are staged before
      pull request preparation.
    llm_type: simple_task
    pre_step:
      action: invoke_tool
      template:
        tool: internal
        command:
        - powdrr-lift
        - repository-state
  - description: Run finish-pr-prep on the validated planning artifacts.
    step_type: freeform
    id: prepare-feature-pull-request
    details: Run finish-pr-prep after the validated planning artifacts are staged.
      If cleanup changes files, restage only those artifacts before continuing. Do
      not implement any proposed PR in this skill.
    llm_type: fast_iteration
    uses_skills:
    - finish-pr-prep
  - description: Commit the validated artifacts and open a draft pull request.
    step_type: freeform
    id: create-feature-pull-request
    details: Invoke create-pull-request with pr-kind `feature`, commit message `Add
      <feature-name> implementation workflow`, and pull-request title `<pull-request-title>`.
      Pass files_to_publish containing exactly every validated file under docs/proposals/<feature-name>/
      and docs/workflows/, plus the validated planning artifacts and Feature Plan
      context. The nested skill must stage exactly that list. Do not advance until
      it has committed, pushed, and created or updated a pull request successfully.
      Never claim a PR is ready without a returned PR URL.
    llm_type: simple_task
    uses_skills:
    - create-pull-request
  - description: Hand the draft pull request to the user for review.
    step_type: freeform
    id: handoff-feature-pull-request
    details: Show the pull request URL. Summarize the selected feature specification,
      every proposed-PR implementation specification, every execution workflow, and
      their dependency relationships. State that implementation has not begun and
      the draft pull request is ready for review.
    llm_type: standard_reasoning
