{
  "when_to_use": [
    "When a feature has plan documents and is ready to become implementation work.",
    "When the work should confirm requirements before splitting the plan into proposed PRs."
  ],
  "how_to_fill_this_out": [
    "Review the existing plan documents before making implementation decisions.",
    "Keep the confirmed requirements explicit in the task state.",
    "Generate one execute-proposed-pr workflow for each approved proposed PR."
  ],
  "task_templates": [
    {
      "description": "Review plan documents",
      "complexity": "high",
      "assignee_type": "agent",
      "assignee_role": "architect",
      "llm_type": "high_reasoning",
      "details": "Read the system, architecture, implementation, and proposed PR plan documents and summarize the implementation scope.",
      "input_state": {
        "plan_documents": []
      },
      "output_state_type": "reviewed-plan-documents-state",
      "upstream_task_template_indexes": [],
      "dependent_state": [
        "plan-documents-reviewed"
      ]
    },
    {
      "description": "Confirm requirements",
      "complexity": "medium",
      "assignee_type": "human",
      "assignee_role": "decider",
      "llm_type": "standard_reasoning",
      "details": "Confirm that the requirements, constraints, and success criteria still match the implementation plan.",
      "input_state": {
        "requirements": [],
        "constraints": [],
        "success_criteria": []
      },
      "output_state_type": "confirmed-requirements-state",
      "upstream_task_template_indexes": [
        0
      ],
      "dependent_state": [
        "requirements-confirmed"
      ]
    },
    {
      "description": "Generate proposed PRs",
      "complexity": "high",
      "assignee_type": "agent",
      "assignee_role": "architect",
      "llm_type": "high_reasoning",
      "details": "Turn the confirmed requirements into proposed PRs and generate an execute-proposed-pr workflow template for each approved PR.",
      "tool_invocations": [
        {
          "tool": "shell",
          "command": [
            "powdrr-lift",
            "instantiate-workflow",
            "--work-item-name",
            "<execute-work-item-name>",
            "--template",
            "templates/execute-proposed-pr.json"
          ]
        }
      ],
      "input_state": {
        "proposed_prs": []
      },
      "output_state_type": "proposed-prs-and-execution-workflows-state",
      "upstream_task_template_indexes": [
        1
      ],
      "dependent_state": [
        "proposed-prs-generated",
        "execute-proposed-pr-workflows-generated"
      ]
    }
  ]
}
